{
  "name": "ledgermark-ir-full-tour-deployed",
  "baseUrl": "https://app-production-daca.up.railway.app",
  "fps": 30,
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "auth": {
    "statePath": ".auth/{account}.json",
    "defaultAccount": "admin",
    "accounts": {
      "consumer": {
        "email": "consumer@ledgermark.com",
        "password": {
          "env": "LM_DEMO_PASSWORD"
        },
        "home": "/app"
      },
      "store": {
        "email": "store@ledgermark.com",
        "password": {
          "env": "LM_DEMO_PASSWORD"
        },
        "home": "/partner"
      },
      "distributor": {
        "email": "distributor@ledgermark.com",
        "password": {
          "env": "LM_DEMO_PASSWORD"
        },
        "home": "/partner"
      },
      "field": {
        "email": "officer@ledgermark.com",
        "password": {
          "env": "LM_DEMO_PASSWORD"
        },
        "home": "/field"
      },
      "inspector": {
        "email": "inspector@ledgermark.com",
        "password": {
          "env": "LM_DEMO_PASSWORD"
        },
        "home": "/console"
      },
      "admin": {
        "email": "admin@ledgermark.com",
        "password": {
          "env": "LM_DEMO_PASSWORD"
        },
        "home": "/console"
      }
    },
    "steps": [
      {
        "do": "goto",
        "url": "/login?next={home}&switch=1&email={email}"
      },
      {
        "do": "wait",
        "selector": [
          "input[type=\"password\"]",
          "#password",
          "#lm-password"
        ]
      },
      {
        "do": "fill",
        "selector": [
          "input[type=\"password\"]",
          "#password",
          "#lm-password"
        ],
        "value": "{password}",
        "typeDelayMs": 0
      },
      {
        "do": "click",
        "selector": [
          "button[type=\"submit\"]",
          "button:has-text(\"로그인\")",
          "#lm-signin"
        ],
        "ms": 2500
      }
    ]
  },
  "redact": [],
